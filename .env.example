# Токен бота от @BotFather
BOT_TOKEN=your_bot_token_here

# Ключ к Claude через proxyapi.ru (российский посредник, принимает рублёвые карты)
# Получить: https://proxyapi.ru
PROXYAPI_KEY=your_proxyapi_key_here

# Модель Claude (по умолчанию используется claude-sonnet-4-6)
CLAUDE_MODEL=claude-sonnet-4-6

# HTTP-прокси для Telegram API.
# Если VPN в режиме TUN (заворачивает весь трафик ОС) — оставить пустым.
# Если v2RayTun с локальным портом — указать: http://127.0.0.1:12334
PROXY_URL=

# Альтернатива: прямой ключ Anthropic (если есть способ его оплатить из РФ)
# ANTHROPIC_KEY=your_anthropic_key_here
